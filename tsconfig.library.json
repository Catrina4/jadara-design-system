{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "jsx": "react-jsx",

    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,

    "outDir": "./dist",
    "rootDir": "./src",

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "types": ["vite/client"]
  },

  "include": ["src"]
}
